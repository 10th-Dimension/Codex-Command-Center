{
  "name": "codex-command-center",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "audit:d1": "node scripts/audit-d1.mjs",
    "backfill:codex-rollups": "node --import tsx scripts/backfill-codex-rollups.mjs",
    "repair:pricing-attribution": "node scripts/repair-pricing-attribution.mjs",
    "telemetry:relay": "tsx scripts/telemetry-relay.ts",
    "install:codex-live-shortcut": "cscript //nologo scripts\\install-codex-live-shortcut.vbs",
    "check:vinext": "vinext check",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "postbuild:vinext": "npx next typegen && node scripts/clean-vinext-private-artifacts.mjs",
    "build:overlay": "npm --prefix desktop/overlay run build",
    "preview:workers": "wrangler dev --config dist/server/wrangler.json",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "lucide-react": "1.44.0",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "server-only": "^0.0.1",
    "vinext": "^1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "vite": "^8.3.0",
    "wrangler": "^4.131.0"
  },
  "type": "module"
}
